{
  "name": "dsh-svw-waveform",
  "version": "0.1.3",
  "description": "Native SVW waveform rendering plugin for DeepSeek Harness",
  "svwRelease": "release-0.1.4",
  "svwArtifacts": {
    "linux-x64": {
      "asset": "svw-release-0.1.4-linux-x64.tar.gz",
      "archiveSha256": "3003233cabca0e140996011ca06369fc0732fdc93c6fc5e01bcd969a2bc4dca2",
      "binarySha256": "7414eccc0ec85c6a96f433615c87f7a530151de43c83459254710a02504b6d52"
    },
    "macos-arm64": {
      "asset": "svw-release-0.1.4-macos-arm64.tar.gz",
      "archiveSha256": "727010698dcfb87214d3a7f4151ac7e139e9caf573d0b8b09b33944155cc4c7a",
      "binarySha256": "eaaa1241a4b4766aa942d9a9d40217fbf4a34b23395c27d6a1cb1c413683c742"
    }
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.cjs",
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "svw-source.json"
  ],
  "workspaces": [
    "npm/*"
  ],
  "scripts": {
    "test": "node --test",
    "verify": "node scripts/verify-package.mjs && node --test",
    "verify:identity": "sh test/git-hooks.sh"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "systemverilog",
    "waveform",
    "vcd",
    "fst",
    "eda"
  ],
  "author": "SVComplex",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svcomplex-dev/dsh-svw-waveform.git"
  },
  "bugs": {
    "url": "https://github.com/svcomplex-dev/dsh-svw-waveform/issues"
  },
  "homepage": "https://github.com/svcomplex-dev/dsh-svw-waveform#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "optionalDependencies": {
    "dsh-svw-waveform-linux-x64": "0.1.3",
    "dsh-svw-waveform-darwin-arm64": "0.1.3"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
