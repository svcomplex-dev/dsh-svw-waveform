{
  "name": "dsh-svw-waveform",
  "version": "0.1.2",
  "description": "Native SVW waveform rendering plugin for DeepSeek Harness",
  "svwRelease": "release-0.1.2",
  "svwArtifacts": {
    "linux-x64": {
      "asset": "svw-release-0.1.2-linux-x64.tar.gz",
      "archiveSha256": "df55e43bf2b12f7e10b4d48c07d4212d2f53811152be78b01aed2db6dda1cb70",
      "binarySha256": "60403f277c4388d485fba355c1411f041b95ef6350e86733a3c1660d6484be41"
    },
    "macos-arm64": {
      "asset": "svw-release-0.1.2-macos-arm64.tar.gz",
      "archiveSha256": "9d7893bf4aee6227f65b4383760f08ab429a2fe55c0328d36a88e140bb3a686b",
      "binarySha256": "eca56a6246ff56e8c708c2dca0e31686fed2d76ec8ca5f7efb9677d609863070"
    }
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.cjs",
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "svw-source.json"
  ],
  "workspaces": [
    "npm/*"
  ],
  "scripts": {
    "test": "node --test",
    "verify": "node scripts/verify-package.mjs && node --test",
    "verify:identity": "sh test/git-hooks.sh"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "systemverilog",
    "waveform",
    "vcd",
    "fst",
    "eda"
  ],
  "author": "SVComplex",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svcomplex-dev/dsh-svw-waveform.git"
  },
  "bugs": {
    "url": "https://github.com/svcomplex-dev/dsh-svw-waveform/issues"
  },
  "homepage": "https://github.com/svcomplex-dev/dsh-svw-waveform#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "optionalDependencies": {
    "dsh-svw-waveform-linux-x64": "0.1.2",
    "dsh-svw-waveform-darwin-arm64": "0.1.2"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
