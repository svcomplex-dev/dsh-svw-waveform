{
  "name": "dsh-svw-waveform",
  "version": "0.1.1",
  "description": "Native SVW waveform rendering plugin for DeepSeek Harness",
  "svwRelease": "release-0.1.1",
  "svwArtifacts": {
    "linux-x64": {
      "asset": "svw-release-0.1.1-linux-x64.tar.gz",
      "archiveSha256": "3e203c75f023090c98bbbd679ff34838c2885b15689e0290e88590409c93f0ab",
      "binarySha256": "ea75984daa17d634f19727e39c4b797779059130bc8983880c2b497c83fcbddb"
    },
    "macos-arm64": {
      "asset": "svw-release-0.1.1-macos-arm64.tar.gz",
      "archiveSha256": "782d83224924008fd862241bd6fae85f978082fd6922bd4cf23aaee757fa518d",
      "binarySha256": "2ca7e0743eb6c11f8f2276c94c7ff5ec6ba985aa604aaa85ccd676ff896dec30"
    }
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.cjs",
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "svw-source.json"
  ],
  "workspaces": [
    "npm/*"
  ],
  "scripts": {
    "test": "node --test",
    "verify": "node scripts/verify-package.mjs && node --test",
    "verify:identity": "sh test/git-hooks.sh"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "systemverilog",
    "waveform",
    "vcd",
    "fst",
    "eda"
  ],
  "author": "SVComplex",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svcomplex-dev/dsh-svw-waveform.git"
  },
  "bugs": {
    "url": "https://github.com/svcomplex-dev/dsh-svw-waveform/issues"
  },
  "homepage": "https://github.com/svcomplex-dev/dsh-svw-waveform#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "optionalDependencies": {
    "dsh-svw-waveform-linux-x64": "0.1.1",
    "dsh-svw-waveform-darwin-arm64": "0.1.1"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
